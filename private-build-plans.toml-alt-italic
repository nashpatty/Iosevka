[buildPlans.iosevka]
family = "Iosevka"
spacing = "fixed"
serifs = "sans"
no-cv-ss = true

  [buildPlans.iosevka.variants]
  inherits = "ss20"

    [buildPlans.iosevka.variants.design]
    capital-b = "standard-unilateral-serifed"
    capital-d = "standard-unilateral-serifed"
    l = "zshaped"
    zero = "slashed-split"
    four = "closed"
    five = "oblique-upper-left-bar"
    six = "straight-bar"
    seven = "curly-serifless"
    eight = "two-circles"
    nine = "straight-bar"
    asterisk = "penta-low"
    number-sign = "slanted"
    ampersand = "upper-open"
    dollar = "open"
    cent = "open"
    punctuation-dot = "square"

    [buildPlans.iosevka.variants.italic]
    g = "single-storey-serifless"
    f = "diagonal-tailed"
    i = "serifed-diagonal-tailed"
    j = "diagonal-tailed-serifed"
    k = "diagonal-tailed-cursive-serifless"
    l = "serifed-diagonal-tailed"
    q = "diagonal-tailed"
    t = "diagonal-tailed"

[buildPlans.iosevka.weights.regular]
shape = 400
menu = 400
css = 400

[buildPlans.iosevka.weights.medium]
shape = 500
menu = 500
css = 500

[buildPlans.iosevka.weights.bold]
shape = 700
menu = 700
css = 700

[buildPlans.iosevka.slopes.upright]
angle = 0
shape = "upright"
menu = "upright"
css = "normal"

[buildPlans.iosevka.slopes.italic]
angle = 9.4
shape = "italic"
menu = "italic"
css = "italic"
